PORT=5000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
CLIENT_ORIGINS=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Bounding Curve <support@boundingcurve.com>
MARKET_DATA_API_KEY=
CRYPTOCOMPARE_API_KEY=
COINDESK_DATA_API_KEY=
# Streaming is opt-in. Keep disabled until the provider quota supports it.
MARKET_STREAM_ENABLED=true
MARKET_REST_ENABLED=true
MARKET_STREAM_SYMBOLS=BTC,ETH,SOL,XRP,ADA,DOGE,BNB,AVAX,TRX,LINK,DOT,MATIC,LTC,BCH,ATOM,NEAR,APT,ARB,FIL,ALGO,USDT,USDC
MARKET_STREAM_MAX_SYMBOLS=100
# Provider headers are authoritative; this is a local backstop for runaway code.
MARKET_REST_REQUESTS_PER_HOUR=120
MARKET_RATE_LIMIT_RESERVE=100
MARKET_QUOTE_CACHE_SECONDS=300
MARKET_HISTORY_CACHE_SECONDS=21600
ALPHA_VANTAGE_API_KEY=
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
BASE_RPC_URL=https://base-rpc.publicnode.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bounding-curve
